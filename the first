                        borderColor: '#2d7dd6',
                        backgroundColor: 'rgba(45, 125, 214, 0.05)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointBackgroundColor: '#2d7dd6',
                        pointBorderColor: 'white',
                        pointBorderWidth: 2,
                        pointHoverRadius: 7,
                        borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            min: 3.0,
                            max: 4.7,
                            ticks: { font: { size: 11 }, color: '#666' },
                            grid: { color: '#e0e0e0' }
                        },
                        x: {
                            ticks: { font: { size: 11 }, color: '#666' },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Load
        window.addEventListener('load', initializeReport);
    </script>
