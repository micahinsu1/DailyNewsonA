    <script>
        // Initialize
        function initializeReport() {
            const lastUpdate = localStorage.getItem('reportLastUpdate');
            if (lastUpdate) {
                document.getElementById('lastUpdateTime').textContent = lastUpdate;
            }
            drawChart();
        }

        // Update Handler
        function handleUpdate() {
            const today = new Date().toISOString().split('T')[0];
            const lastUpdate = localStorage.getItem('reportLastUpdate');

            const statusEl = document.getElementById('updateStatus');

            if (lastUpdate === today) {
                // 오늘 이미 업데이트됨
                statusEl.className = 'update-status show warning';
                statusEl.innerHTML = '⚠️ <strong>There is no update</strong><br>Today\'s report has already been updated.';
                setTimeout(() => {
                    statusEl.classList.remove('show');
                }, 4000);
            } else {
                // 첫 업데이트
                statusEl.className = 'update-status show info';
                statusEl.innerHTML = '⏳ <strong>Updating...</strong><br>Fetching latest news and generating report...';

                // 실제로는 여기서 Claude에게 업데이트 요청해야 함
                // 지금은 시뮬레이션
                setTimeout(() => {
                    localStorage.setItem('reportLastUpdate', today);
                    const now = new Date().toLocaleString('ko-KR');
                    document.getElementById('lastUpdateTime').textContent = now;

                    statusEl.className = 'update-status show success';
                    statusEl.innerHTML = '✅ <strong>Report Updated</strong><br>Latest data has been loaded successfully.';

                    setTimeout(() => {
                        statusEl.classList.remove('show');
                    }, 3000);
                }, 2000);
            }
        }

        // Chart
        function drawChart() {
            const ctx = document.getElementById('rateChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['2023.04', '2023.08', '2024.01', '2024.04', '2024.08', '2025.01', '2025.04', '2025.08', '2026.01', '2026.04.23', '2026.06.04', '2026.08.28'],
